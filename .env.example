# ── Database (PostgreSQL) ──────────────────────────────
# Local example; in production use Neon/Supabase pooled URL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/oottam?schema=public"

# ── Seed: initial OWNER admin (no password; login will be phone OTP) ──
SEED_OWNER_PHONE="+91XXXXXXXXXX"
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_NAME="Oottam Owner"

# ── Public site config ────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="919245537575"

# ── Auth & security (Module 3) ────────────────────────
# Generate each with: openssl rand -base64 48   (required in production, ≥32 chars)
AUTH_SECRET=""
OTP_HASH_SECRET=""
# SMS for login codes: dev (prints to server console) | msg91 | twilio
SMS_PROVIDER="dev"
# Only for running a production build locally with the console provider. NEVER on the live site.
# ALLOW_DEV_SMS_IN_PRODUCTION="true"

# ── Checkout rules (Module 3) ─────────────────────────
DELIVERY_FEE_PAISE="4900"              # ₹49 flat delivery
FREE_DELIVERY_THRESHOLD_PAISE="49900"  # free delivery from ₹499 (after discount); 0 = always free
FEATURE_COD="false"                    # Cash on delivery (owner decision, default off)
PENDING_ORDER_TTL_MINUTES="30"         # unpaid Razorpay orders release stock after this

# ── Online payments (Module 4) ────────────────────────
# upi = direct UPI to the shop's UPI ID, verified by OWNER/STAFF at /admin/payments
ONLINE_PAYMENT_PROVIDER="upi"
UPI_VPA="yourshop@okhdfcbank"          # UPI ID customers pay to
UPI_VPA_ALT=""                         # optional alternate UPI ID for the same account
UPI_PAYEE_NAME="Account Holder Name"   # should match the bank account name
UPI_PAYMENT_WINDOW_MINUTES="1440"      # unpaid UPI orders hold stock for 24 h
UPI_INCLUDE_TR="true"                  # set false if a UPI app rejects the tr= reference

# ── Admin access & notifications (Module 4b) ─────────
# Owner password sign-in at /admin/login while SMS isn't set up. ≥16 chars (openssl rand -base64 24). Empty = off.
ADMIN_ACCESS_PASSWORD=""
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/release-expired. ≥16 chars.
CRON_SECRET=""
# Optional outbound alerts (in-app notifications always work). Each channel turns on when its vars are set.
# RESEND_API_KEY=""
# ADMIN_ALERT_EMAIL="owner@example.com"         # comma-separated
# ALERT_EMAIL_FROM="Oottam alerts <alerts@yourdomain>"   # default uses Resend's onboarding sender
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""

# ── Tests ─────────────────────────────────────────────
# Separate database for integration tests (never the same as DATABASE_URL)
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/oottam_test?schema=public"

# ── Later modules (leave blank for now) ───────────────
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
